<Window x:Class="CornnerPCRescue.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="CornnerPCRescue" Width="1280" Height="820" MinWidth="1100" MinHeight="700" Background="{StaticResource Bg}" FontFamily="Segoe UI">
    <Window.Resources><Style TargetType="Button"><Setter Property="Margin" Value="0,6"/><Setter Property="Padding" Value="16,12"/><Setter Property="Background" Value="#1F2937"/><Setter Property="Foreground" Value="#E5E7EB"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="16"/></Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#E5E7EB"/></Style></Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Left" Width="260" Background="#070D18" Padding="18">
            <StackPanel><TextBlock Text="🛡 CornnerPCRescue" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/><Button Content="Dashboard" Click="Nav_Click"/><Button Content="Scan PC" Click="Nav_Click"/><Button Content="Windows Maintenance" Click="Nav_Click"/><Button Content="Gaming / FiveM" Click="Nav_Click"/><Button Content="Network" Click="Nav_Click"/><Button Content="Backup &amp; Restore" Click="Nav_Click"/><Button Content="Reports" Click="Nav_Click"/><Button Content="Settings" Click="Nav_Click"/><Separator Margin="0,18"/><TextBlock Text="Preview Mode"/><CheckBox IsChecked="{Binding IsPreviewMode}" Foreground="#E5E7EB" Content="เปิด Preview เป็นค่าเริ่มต้น" Margin="0,8"/><TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Foreground="#93C5FD"/></StackPanel>
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto"><Border Padding="28"><StackPanel>
            <TextBlock Text="{Binding CurrentPage}" FontSize="34" FontWeight="Bold" Margin="0,0,0,18"/>
            <UniformGrid Columns="4" Margin="0,0,0,18">
                <Border Background="{StaticResource Panel}" Padding="18" Margin="6"><StackPanel><TextBlock Text="Health Score"/><TextBlock Text="{Binding Dashboard.HealthScore}" FontSize="42" Foreground="{StaticResource Accent}"/></StackPanel></Border>
                <Border Background="{StaticResource Panel}" Padding="18" Margin="6"><StackPanel><TextBlock Text="CPU"/><TextBlock Text="{Binding Dashboard.Cpu}" TextWrapping="Wrap"/></StackPanel></Border>
                <Border Background="{StaticResource Panel}" Padding="18" Margin="6"><StackPanel><TextBlock Text="RAM"/><TextBlock Text="{Binding Dashboard.RamTotal}" TextWrapping="Wrap"/></StackPanel></Border>
                <Border Background="{StaticResource Panel}" Padding="18" Margin="6"><StackPanel><TextBlock Text="GPU"/><TextBlock Text="{Binding Dashboard.Gpu}" TextWrapping="Wrap"/></StackPanel></Border>
                <Border Background="{StaticResource Panel}" Padding="18" Margin="6"><StackPanel><TextBlock Text="System Drive"/><TextBlock Text="{Binding Dashboard.SystemDrive}"/></StackPanel></Border>
                <Border Background="{StaticResource Panel}" Padding="18" Margin="6"><StackPanel><TextBlock Text="Windows"/><TextBlock Text="{Binding Dashboard.WindowsVersion}"/></StackPanel></Border>
                <Border Background="{StaticResource Panel}" Padding="18" Margin="6"><StackPanel><TextBlock Text="Power Plan"/><TextBlock Text="{Binding Dashboard.PowerPlan}" TextWrapping="Wrap"/></StackPanel></Border>
                <Border Background="{StaticResource Panel}" Padding="18" Margin="6"><StackPanel><TextBlock Text="Mode / Backup / FiveM"/><TextBlock><Run Text="Mode: "/><Run Text="{Binding Dashboard.Mode}"/></TextBlock><TextBlock Text="{Binding Dashboard.BackupStatus}"/><TextBlock Text="{Binding Dashboard.FiveMStatus}"/></StackPanel></Border>
            </UniformGrid>
            <Button Content="🔎 Scan PC ขนาดใหญ่" Command="{Binding ScanCommand}" Background="#0369A1" FontSize="22" Padding="22"/>
            <WrapPanel Margin="0,12"><Button Content="Preview Maintenance" Command="{Binding PreviewMaintenanceCommand}" Margin="0,6,10,6"/><Button Content="อ่านค่า Network" Command="{Binding NetworkCommand}" Margin="0,6,10,6"/><Button Content="สร้าง Backup Manifest" Command="{Binding BackupCommand}" Margin="0,6,10,6"/></WrapPanel>
            <TextBlock Text="ผล Scan PC" FontSize="24" FontWeight="SemiBold" Margin="0,18,0,8"/><ItemsControl ItemsSource="{Binding ScanResults}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="{StaticResource Panel}" Padding="14" Margin="0,5"><StackPanel><TextBlock FontSize="18" FontWeight="Bold" Text="{Binding Name}"/><TextBlock Text="{Binding Status}" Foreground="#A7F3D0"/><TextBlock Text="{Binding Summary}"/><TextBlock Text="{Binding Evidence}" TextWrapping="Wrap" Foreground="#CBD5E1"/><TextBlock Text="{Binding Recommendation}" TextWrapping="Wrap"/><TextBlock Text="{Binding Severity}" Foreground="#FBBF24"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            <TextBlock Text="Preview / Actions" FontSize="24" FontWeight="SemiBold" Margin="0,18,0,8"/><Border Background="{StaticResource Panel}" Padding="16"><StackPanel><TextBlock Text="{Binding CurrentPreview.Title}" FontSize="18"/><TextBlock Text="{Binding CurrentPreview.Description}" TextWrapping="Wrap"/><ItemsControl ItemsSource="{Binding CurrentPreview.Actions}"/><TextBlock Text="Forbidden safety rules:" Foreground="#FCA5A5"/><ItemsControl ItemsSource="{Binding CurrentPreview.ForbiddenActions}"/></StackPanel></Border>
            <TextBlock Text="Network" FontSize="24" FontWeight="SemiBold" Margin="0,18,0,8"/><Border Background="{StaticResource Panel}" Padding="16"><TextBlock TextWrapping="Wrap"><Run Text="Adapter: "/><Run Text="{Binding NetworkSnapshot.Adapter}"/><LineBreak/><Run Text="IP: "/><Run Text="{Binding NetworkSnapshot.Ip}"/><LineBreak/><Run Text="Gateway: "/><Run Text="{Binding NetworkSnapshot.Gateway}"/><LineBreak/><Run Text="DNS: "/><Run Text="{Binding NetworkSnapshot.Dns}"/><LineBreak/><Run Text="Link: "/><Run Text="{Binding NetworkSnapshot.LinkSpeed}"/><LineBreak/><Run Text="Ping: "/><Run Text="{Binding NetworkSnapshot.InternetPing}"/></TextBlock></Border>
            <TextBlock Text="Reports" FontSize="24" FontWeight="SemiBold" Margin="0,18,0,8"/><ItemsControl ItemsSource="{Binding Reports}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock><Run Text="{Binding Timestamp}"/><Run Text=" - "/><Run Text="{Binding Title}"/><Run Text=" - "/><Run Text="{Binding Details}"/></TextBlock></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </StackPanel></Border></ScrollViewer>
    </DockPanel>
</Window>
