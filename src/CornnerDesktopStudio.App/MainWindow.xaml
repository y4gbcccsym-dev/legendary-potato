<Window x:Class="CornnerDesktopStudio.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Cornner Desktop Studio" Width="1280" Height="800" MinWidth="1000" MinHeight="650" Background="{StaticResource BackgroundBrush}">
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Background="#10182A" Padding="16"><DockPanel><TextBlock DockPanel.Dock="Top" Text="Cornner Desktop Studio" Foreground="{StaticResource TextBrush}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,18"/><ListBox ItemsSource="{Binding NavigationItems}" SelectedItem="{Binding SelectedPage}" Background="Transparent" Foreground="{StaticResource TextBrush}" BorderThickness="0"/></DockPanel></Border>
<ScrollViewer Grid.Column="1" Padding="24"><StackPanel><TextBlock Text="{Binding SelectedPage}" Foreground="{StaticResource TextBrush}" FontSize="32" FontWeight="SemiBold"/><TextBlock Text="Modern safe desktop control center / ศูนย์ควบคุมเดสก์ท็อปแบบปลอดภัย" Foreground="{StaticResource MutedTextBrush}" Margin="0,6,0,18"/>
<WrapPanel><Button Content="Preview Changes" Command="{Binding PreviewCommand}" ToolTip="Preview safe draft changes"/><Button Content="Apply Profile" Command="{Binding ApplyCommand}" ToolTip="Create backup then apply"/><Button Content="Restore Last Backup" Command="{Binding RestoreCommand}"/></WrapPanel>
<UniformGrid Columns="3" Margin="0,14,0,14"><Border Background="{StaticResource CardBrush}" Padding="16" Margin="6"><StackPanel><TextBlock Text="Active Profile" Foreground="{StaticResource MutedTextBrush}"/><TextBlock Text="Gaming" Foreground="{StaticResource TextBrush}" FontSize="24"/></StackPanel></Border><Border Background="{StaticResource CardBrush}" Padding="16" Margin="6"><StackPanel><TextBlock Text="Widgets" Foreground="{StaticResource MutedTextBrush}"/><TextBlock Text="5 active" Foreground="{StaticResource TextBrush}" FontSize="24"/></StackPanel></Border><Border Background="{StaticResource CardBrush}" Padding="16" Margin="6"><StackPanel><TextBlock Text="Startup" Foreground="{StaticResource MutedTextBrush}"/><TextBlock Text="User controlled" Foreground="{StaticResource TextBrush}" FontSize="24"/></StackPanel></Border></UniformGrid>
<DataGrid ItemsSource="{Binding PreviewItems}" AutoGenerateColumns="True" MinHeight="220" Background="{StaticResource CardBrush}" Foreground="{StaticResource TextBrush}"/>
<TextBlock Text="{Binding Status}" Foreground="{StaticResource AccentBrush}" Margin="0,14,0,0"/></StackPanel></ScrollViewer></Grid>
</Window>
